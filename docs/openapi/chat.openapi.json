{
  "components": {
    "schemas": {
      "AddUsageOperation": {
        "additionalProperties": false,
        "properties": {
          "billing": {
            "$ref": "#/components/schemas/UsageEvent"
          },
          "kind": {
            "const": "add_usage",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "billing"
        ],
        "title": "AddUsageOperation",
        "type": "object"
      },
      "BillingPeriod": {
        "additionalProperties": false,
        "properties": {
          "month": {
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "type": "integer"
          },
          "subscriberNo": {
            "minLength": 1,
            "title": "Subscriberno",
            "type": "string"
          },
          "year": {
            "maximum": 9999.0,
            "minimum": 1.0,
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "subscriberNo",
          "year",
          "month"
        ],
        "title": "BillingPeriod",
        "type": "object"
      },
      "CalculateBillOperation": {
        "additionalProperties": false,
        "properties": {
          "billing": {
            "$ref": "#/components/schemas/BillingPeriod"
          },
          "kind": {
            "const": "calculate_bill",
            "title": "Kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "billing"
        ],
        "title": "CalculateBillOperation",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "question": {
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "dialogue": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/DialogueStep"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dialogue"
          },
          "pending_payment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingPayment"
              },
              {
                "type": "null"
              }
            ]
          },
          "tool_trace": {
            "items": {
              "$ref": "#/components/schemas/ToolTrace"
            },
            "title": "Tool Trace",
            "type": "array"
          }
        },
        "required": [
          "answer",
          "tool_trace"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "ConfirmOperationRequest": {
        "additionalProperties": false,
        "properties": {
          "confirmation_id": {
            "format": "uuid",
            "title": "Confirmation Id",
            "type": "string"
          }
        },
        "required": [
          "confirmation_id"
        ],
        "title": "ConfirmOperationRequest",
        "type": "object"
      },
      "ConfirmPaymentRequest": {
        "additionalProperties": false,
        "properties": {
          "confirmation_id": {
            "format": "uuid",
            "title": "Confirmation Id",
            "type": "string"
          }
        },
        "required": [
          "confirmation_id"
        ],
        "title": "ConfirmPaymentRequest",
        "type": "object"
      },
      "DemoLoginRequest": {
        "additionalProperties": false,
        "properties": {
          "password": {
            "format": "password",
            "title": "Password",
            "type": "string",
            "writeOnly": true
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "DemoLoginRequest",
        "type": "object"
      },
      "DialogueStep": {
        "properties": {
          "kind": {
            "enum": [
              "request",
              "tool_call",
              "tool_result",
              "answer"
            ],
            "title": "Kind",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "kind",
          "payload"
        ],
        "title": "DialogueStep",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PaymentResult": {
        "properties": {
          "paidAmount": {
            "title": "Paidamount",
            "type": "string"
          },
          "remainingBalance": {
            "title": "Remainingbalance",
            "type": "string"
          },
          "status": {
            "const": "success",
            "default": "success",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "paidAmount",
          "remainingBalance"
        ],
        "title": "PaymentResult",
        "type": "object"
      },
      "PendingOperation": {
        "properties": {
          "confirmation_id": {
            "format": "uuid",
            "title": "Confirmation Id",
            "type": "string"
          },
          "operation": {
            "discriminator": {
              "mapping": {
                "add_usage": "#/components/schemas/AddUsageOperation",
                "calculate_bill": "#/components/schemas/CalculateBillOperation"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/AddUsageOperation"
              },
              {
                "$ref": "#/components/schemas/CalculateBillOperation"
              }
            ],
            "title": "Operation"
          }
        },
        "required": [
          "confirmation_id",
          "operation"
        ],
        "title": "PendingOperation",
        "type": "object"
      },
      "PendingPayment": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "confirmation_id": {
            "format": "uuid",
            "title": "Confirmation Id",
            "type": "string"
          },
          "month": {
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "type": "integer"
          },
          "year": {
            "maximum": 9999.0,
            "minimum": 1.0,
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "year",
          "month",
          "amount",
          "confirmation_id"
        ],
        "title": "PendingPayment",
        "type": "object"
      },
      "ToolTrace": {
        "properties": {
          "arguments": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Arguments",
            "type": "object"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "result": {
            "additionalProperties": true,
            "title": "Result",
            "type": "object"
          }
        },
        "required": [
          "name",
          "arguments",
          "result"
        ],
        "title": "ToolTrace",
        "type": "object"
      },
      "TransactionStatus": {
        "properties": {
          "status": {
            "const": "success",
            "default": "success",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "TransactionStatus",
        "type": "object"
      },
      "UsageEvent": {
        "additionalProperties": false,
        "properties": {
          "month": {
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Month",
            "type": "integer"
          },
          "subscriberNo": {
            "minLength": 1,
            "title": "Subscriberno",
            "type": "string"
          },
          "usageType": {
            "enum": [
              "Phone",
              "Internet"
            ],
            "title": "Usagetype",
            "type": "string"
          },
          "year": {
            "maximum": 9999.0,
            "minimum": 1.0,
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "subscriberNo",
          "year",
          "month",
          "usageType"
        ],
        "title": "UsageEvent",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Billing Support Chat",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login"
      }
    },
    "/api/v1/chat": {
      "post": {
        "operationId": "chat_api_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat"
      }
    },
    "/api/v1/chat/payments/confirm": {
      "post": {
        "operationId": "confirm_payment_api_v1_chat_payments_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Confirm Payment"
      }
    },
    "/api/v1/operator/operations/confirm": {
      "post": {
        "operationId": "confirm_api_v1_operator_operations_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmOperationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Confirm",
        "tags": [
          "Operator"
        ]
      }
    },
    "/api/v1/operator/operations/prepare": {
      "post": {
        "operationId": "prepare_api_v1_operator_operations_prepare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "discriminator": {
                  "mapping": {
                    "add_usage": "#/components/schemas/AddUsageOperation",
                    "calculate_bill": "#/components/schemas/CalculateBillOperation"
                  },
                  "propertyName": "kind"
                },
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/AddUsageOperation"
                  },
                  {
                    "$ref": "#/components/schemas/CalculateBillOperation"
                  }
                ],
                "title": "Operation"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PendingOperation"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Prepare",
        "tags": [
          "Operator"
        ]
      }
    }
  }
}
